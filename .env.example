# تنظیمات سرور
PORT=3000
NODE_ENV=production

# امنیت - حتما در سرور تغییر بده
JWT_SECRET=attari_shafa_super_secret_2024_change_this_in_production_CHANGE_ME_64_CHARS
ADMIN_PHONE=09120000000
ADMIN_PASSWORD=1234

# دیتابیس
DB_PATH=./data/database.sqlite

# آپلود
UPLOAD_PATH=./public/uploads
MAX_UPLOAD_SIZE=5242880

# ================= درگاه پرداخت زرین‌پال =================
# از https://www.zarinpal.com/panel/ دریافت کن
# برای تست از سندباکس: https://sandbox.zarinpal.com/panel/
ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ZARINPAL_SANDBOX=false
# آدرس بازگشت بعد از پرداخت - دامنه خودت را بگذار
ZARINPAL_CALLBACK_URL=https://yourdomain.com/api/payment/verify
# یا برای لوکال:
# ZARINPAL_CALLBACK_URL=http://localhost:3000/api/payment/verify

# ================= پیامک کاوه‌نگار =================
# از https://panel.kavenegar.com/ دریافت کن
KAVENEGAR_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
KAVENEGAR_SENDER=10004346
# برای تست، اگر خالی باشد از حالت دمو (لاگ در کنسول) استفاده می‌شود
SMS_ENABLED=false

# تنظیمات پیامک
# الگوهای کاوه‌نگار - از پنل کاوه‌نگار بساز و اینجا بگذار
KAVENEGAR_OTP_TEMPLATE=verify-otp
KAVENEGAR_ORDER_TEMPLATE=order-confirm

# آدرس سایت برای لینک‌ها
SITE_URL=https://yourdomain.com
